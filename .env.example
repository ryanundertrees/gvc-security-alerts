# Server Configuration
PORT=3000
HOST=0.0.0.0
TEAM_PIN=1234
ON_DUTY_TIMEOUT_HOURS=6
DB_PATH=./data/alerts.db

# Web Push VAPID Keys
# Optional: leave blank to auto-generate persistent keys in ./data/vapid.json on first boot,
# or run `npm run setup` to generate them into .env.
VAPID_SUBJECT=mailto:security@gallatinvalleychurch.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Only required if using the Cloudflare Tunnel profile in docker-compose.yml
# (Not needed when hosting behind the church web server's own Nginx/Caddy/Apache reverse proxy)
CLOUDFLARE_TUNNEL_TOKEN=
